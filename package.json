{
  "name": "minecraft-dev-atlas",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin that exports registries, tags and a recipe index from a running Minecraft server, with token-efficient queries and a data panel",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "engine",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh_CN.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "minecraft",
    "modding",
    "registries",
    "recipes",
    "javaagent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-agent.mjs && node scripts/build-client.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-agent.mjs --verify && node scripts/build-client.mjs",
    "test": "node --test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chemiofitor4096/minecraft-dev-atlas.git"
  },
  "homepage": "https://github.com/Chemiofitor4096/minecraft-dev-atlas#readme",
  "bugs": {
    "url": "https://github.com/Chemiofitor4096/minecraft-dev-atlas/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1 || ^0.2.2-rc.1",
    "minecraft-dev-starter": ">=0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "esbuild": "^0.28.2"
  }
}
